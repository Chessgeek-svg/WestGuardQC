# Copy to .env and adjust. Every value here is also the built-in default, so a
# fresh clone runs against the docker-compose stack without this file.

# Async SQLAlchemy URL. The driver must be asyncpg.
DATABASE_URL=postgresql+asyncpg://westguard:westguard@localhost:5432/westguardqc

# The test fixtures drop and recreate every table and refuse to run unless the
# database name ends in _test. `make test` sets this for you.
# DATABASE_URL=postgresql+asyncpg://westguard:westguard@localhost:5432/westguardqc_test

# The frontend reads VITE_API_BASE from frontend/.env, not this file. Leave it
# unset in development: the Vite dev server proxies /api to port 8000, so the
# app calls the API same-origin and the backend needs no CORS middleware.
